# ─── Обязательные параметры ──────────────────────────────────────────────────

# Токен от @BotFather (обязательно)
BOT_TOKEN=

# Белый список Telegram ID через запятую (например: 123456789,987654321)
# Свой ID можно узнать у @userinfobot
# Пусто = доступ всем (только для отладки!)
ALLOWED_USER_IDS=

# ─── Необязательные параметры (можно не трогать) ─────────────────────────────

# Путь к файлу SQLite с историей
DATABASE_PATH=data/history.db

# Папка с Excel-файлами и архивами
FILES_DIR=data/files

# Пауза между запросами к WB (сек). Подними до 0.7–1.0, если в логах появляются 429
WB_REQUEST_DELAY=0.3

# Максимальное время одного сбора (сек). По умолчанию 30 минут
COLLECTION_TIMEOUT=1800

# Как часто редактировать прогресс-сообщение (сек)
PROGRESS_EDIT_INTERVAL=3.0
